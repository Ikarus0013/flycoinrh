# Fork note: every wallet / chain / X / voice secret that used to live here has
# been removed along with the code that read it. There is nothing to sign with,
# no chain to reach, and no account to post from. What remains are the harmless
# roaming knobs, all off/safe by default.

# The roamer never opens a real site unless this is 1 (it defaults off, and the
# fork has no launcher for it to drive anyway).
FLY_ALLOW_BROWSER=0

# Leave the roaming fence up. With this 1 the read-only random walk loses its
# URL blocklist; there is still nothing that can spend, but keep it 0.
FLY_ROAM_OPEN=0
